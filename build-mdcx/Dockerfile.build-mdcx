# syntax=docker/dockerfile:1.4

ARG BASE_IMAGE_TAG=latest
FROM stainless403/build-mdcx-base:$BASE_IMAGE_TAG as builder

LABEL maintainer="stainless403"
LABEL description="base on stainless403/mdcx-build-base:$BASE_IMAGE_TAG"

ARG APP_VERSION
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT
ARG BUILDPLATFORM
ARG BUILDOS
ARG BUILDARCH
ARG BUILDVARIANT

# 输出构建信息
RUN echo "-----Image platform details:" && \
  echo "Target: $TARGETPLATFORM ($TARGETOS/$TARGETARCH/$TARGETVARIANT)" && \
  echo "Build: $BUILDPLATFORM ($BUILDOS/$BUILDARCH/$BUILDVARIANT)"

COPY build-mdcx/.mdcx_src /tmp/mdcx
WORKDIR /tmp/mdcx

# 设置PyPI镜像
ARG PYPI_MIRROR
ARG DEFAULT_MIRROR="https://pypi.doubanio.com/simple"
ENV PYPI_MIRROR=${PYPI_MIRROR:-${DEFAULT_MIRROR}}

# 对于 ARM64 平台，修改 pyproject.toml 移除 PyQt5 依赖
RUN if [ "$TARGETARCH" = "arm64" ]; then \
      echo "ARM64 平台：修改 pyproject.toml 以移除 PyQt5 依赖"; \
      cp pyproject.toml pyproject.toml.bak; \
      # 移除 PyQt5 相关行
      sed -i '/pyqt5/d' pyproject.toml; \
      sed -i '/pyqt5-qt5/d' pyproject.toml; \
      sed -i '/pyqt5-stubs/d' pyproject.toml; \
      echo "修改后的依赖:"; \
      grep -A 20 "dependencies = \[" pyproject.toml; \
    fi

# 设置环境变量使用系统 PyQt5
ENV PYTHONPATH="/usr/lib/python3/dist-packages:$PYTHONPATH"

# 安装依赖
RUN echo "Installing dependencies..." && \
    uv sync --all-extras --dev

RUN uv pip install -e .

# 验证 PyQt5 是否可用
RUN python3 -c "import sys; print('Python path:', sys.path[:3])" && \
    python3 -c "try: import PyQt5.QtCore; print('✅ PyQt5 successfully imported'); print('PyQt5 version:', PyQt5.QtCore.QT_VERSION_STR); print('PyQt5 location:', PyQt5.__file__); except ImportError as e: print('❌ PyQt5 import failed:', e)"

# 保存版本信息
RUN mkdir -p ./dist && echo $APP_VERSION > ./dist/app-version

# 安装依赖并构建
RUN echo "PYPI_MIRROR: $PYPI_MIRROR" && \
  uv run pyinstaller -n MDCx \
  -F -w main.py \
  --add-data "resources:resources" \
  --add-data "libs:." \
  --hidden-import socks \
  --hidden-import urllib3 \
  --hidden-import _cffi_backend \
  --hidden-import PIL \
  --hidden-import PIL.Image \
  --hidden-import PIL.ImageFile \
  --hidden-import PIL.ImageFilter \
  --hidden-import PIL._imaging \
  --collect-all curl_cffi && \
  # 保存版本信息
  echo $APP_VERSION > /tmp/mdcx/dist/app-version && \
  # 清理构建缓存
  rm -rf /tmp/mdcx/build /tmp/mdcx/__pycache__ /root/.cache/pip

# 使用Alpine作为最终镜像
FROM alpine:latest
COPY --from=builder /tmp/mdcx/dist/MDCx /MDCx
COPY --from=builder /tmp/mdcx/dist/app-version /app-version

# 添加执行权限
RUN chmod +x /MDCx

CMD [ "echo", "This image just contains MDCx bin." ]
